@model RaceDay.Mvc.Models.EventDetailsViewModel

@{
    var isParticipant = Context.Session.GetString("Role") == "Participant";
}

<h2>@Model.Name</h2>
<p>@Model.EventDate.ToString("dd MMM yyyy") — @Model.Location</p>
<p>@Model.EventType, @Model.Distance km</p>
<p>@Model.Description</p>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<h4>Categories</h4>

@if (isParticipant)
{
    <form asp-controller="Participant" asp-action="Enrol" method="post">
        <input type="hidden" name="eventId" value="@Model.EventId" />
        <div class="mb-3">
            <select name="categoryId" class="form-select" required>
                <option value="">-- Select a category --</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.CategoryId">@c.CategoryName</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Enrol</button>
    </form>
}
else
{
    <ul>
        @foreach (var c in Model.Categories)
        {
            <li>@c.CategoryName</li>
        }
    </ul>
}