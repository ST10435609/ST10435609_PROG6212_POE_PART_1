@model RaceDay.Mvc.Models.ResultFormViewModel

<h2>Capture Result</h2>

<form asp-action="CaptureResult" method="post">
    <input type="hidden" asp-for="EnrolmentId" />
    <input type="hidden" name="eventId" value="@Context.Request.Query["eventId"]" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="FinishTime" class="form-label"></label>
        <input asp-for="FinishTime" type="time" step="1" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="FinishingPosition" class="form-label"></label>
        <input asp-for="FinishingPosition" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save Result</button>
</form>