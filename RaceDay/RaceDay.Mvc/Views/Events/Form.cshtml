@model RaceDay.Mvc.Models.EventFormViewModel

<h2>@(Model.EventId == 0 ? "Create Event" : "Edit Event")</h2>

<form asp-action="@(Model.EventId == 0 ? "Create" : "Edit")" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="EventId" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Distance" class="form-label">Distance (km)</label>
        <input asp-for="Distance" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select">
            <option value="">-- Select --</option>
            <option value="Run">Run</option>
            <option value="Walk">Walk</option>
            <option value="Cycle">Cycle</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Event Banner Image</label>
        <input type="file" name="bannerFile" class="form-control" accept="image/jpeg,image/png,image/webp" />
        @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
        {
            <div class="mt-2">
                <p class="text-muted">Current banner:</p>
                <img src="@Model.BannerImageUrl" alt="Current event banner" style="max-width: 300px;" />
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>